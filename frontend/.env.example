# Base URL of the deployed backend service.
# Leave empty to use the Vite dev-server proxy (local development).
# In production set this to your Railway backend public URL, e.g.:
# VITE_API_BASE_URL=https://your-backend.up.railway.app
VITE_API_BASE_URL=

# Optional: override the local backend proxy target (dev only)
# VITE_DEV_API_PROXY_TARGET=http://localhost:3001

# Optional: extra hosts to allow in vite preview (comma-separated)
# VITE_ALLOWED_HOSTS=your-frontend.up.railway.app
