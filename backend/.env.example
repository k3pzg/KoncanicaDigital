# Server
PORT=3001
NODE_ENV=development

# Database (DB_* is the primary name; MYSQL_* is accepted as a legacy alias)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=koncanica_digital

# CORS: comma-separated list of allowed frontend origins (production)
# CORS_ORIGINS=https://your-frontend.up.railway.app

# Session
SESSION_TTL_HOURS=24
